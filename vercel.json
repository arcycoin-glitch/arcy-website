{
  "functions": {
    "api/holders.js": {
      "maxDuration": 60,
      "includeFiles": "data/holder-snapshots/**"
    },
    "api/holderrefresh.js": {
      "maxDuration": 60
    },
    "api/search/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/pulse",
      "schedule": "0 6 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/search",
      "destination": "/#search",
      "permanent": false
    },
    {
      "source": "/search/",
      "destination": "/#search",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/activity",
      "destination": "/api/market?_arcyRoute=activity"
    },
    {
      "source": "/search/token/:network/:address",
      "destination": "/search/index.html"
    }
  ],
  "buildCommand": "node --check search-upgrade.js && node --check api/pulse.js && npm test && mkdir -p public && cp index.html public/index.html"
}
