{
  "functions": {
    "api/holders.js": {
      "maxDuration": 60
    },
    "api/holderrefresh.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/pulse",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/holderrefresh",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/activity",
      "destination": "/api/market?_arcyRoute=activity"
    }
  ]
}
