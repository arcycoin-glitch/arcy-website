 "reviewedFunctions": [
  {
   "name": "upgradeTo",
   "file": "open-zeppelin/BaseAdminUpgradeabilityProxy.sol",
   "source": "function upgradeTo(address newImplementation) external ifAdmin { _upgradeTo(newImplementation); }",
   "finding": "external ifAdmin; body is exactly _upgradeTo(newImplementation). For the admin this replaces the implementation; it is handled by the proxy itself and never reaches the implementation."
  },
  {
   "name": "ifAdmin",
   "file": "open-zeppelin/BaseAdminUpgradeabilityProxy.sol",
   "source": "modifier ifAdmin() { if (msg.sender == _admin()) { _; } else { _fallback(); } }",
   "finding": "Runs the function body only when msg.sender equals the address stored in ADMIN_SLOT; every other caller is delegated to the implementation."
  },
  {
   "name": "_admin",
   "file": "open-zeppelin/BaseAdminUpgradeabilityProxy.sol",
   "source": "function _admin() internal view returns (address adm) { bytes32 slot = ADMIN_SLOT; assembly { adm := sload(slot) } }",
   "finding": "Reads the admin from ADMIN_SLOT, which is the EIP-1967 admin slot the producer reads."
  },
  {
   "name": "_upgradeTo",
   "file": "open-zeppelin/BaseUpgradeabilityProxy.sol",
   "source": "function _upgradeTo(address newImplementation) internal { _setImplementation(newImplementation); emit Upgraded(newImplementation); }",
   "finding": "Calls _setImplementation(newImplementation) and emits Upgraded; no other condition."
  },
  {
   "name": "_setImplementation",
   "file": "open-zeppelin/BaseUpgradeabilityProxy.sol",
   "source": "function _setImplementation(address newImplementation) internal { require(Address.isContract(newImplementation), \"Cannot set a proxy implementation to a non-contract address\"); bytes32 slot = IMPLEMENTATION_SLOT; assembly { sstore(slot, newImplementation) } }",
   "finding": "Requires the new implementation to be a contract, then sstore(IMPLEMENTATION_SLOT, newImplementation): the EIP-1967 implementation slot is overwritten."
  }
 ],
 "conclusion": "For this exact proxy runtime code, upgradeTo called by the address in the EIP-1967 admin slot is executed by the proxy itself (it is never delegated) and overwrites the EIP-1967 implementation slot with the supplied contract address. The admin therefore controls which code the proxy runs.",
